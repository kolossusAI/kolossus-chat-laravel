{
    "name": "kolossusai/chat-laravel",
    "description": "Add a KolossusAI chat assistant to your Laravel site with one command.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": ["laravel", "chatbot", "ai", "chat", "assistant", "kolossus"],
    "homepage": "https://kolossus.ai",
    "authors": [
        {
            "name": "Kolossus AI",
            "homepage": "https://kolossus.ai"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "KolossusAI\\Chat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KolossusAI\\Chat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KolossusAI\\Chat\\KolossusChatServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
